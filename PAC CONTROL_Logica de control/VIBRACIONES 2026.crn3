: W_INIT_IO
CONFIG_PORTS
" %GROV_EPIC  (1/1)" *_HSV_INIT_IO $MOVE 0 ^_HNV_INIT_IO @!
%GROV_EPIC ENABLE
 " Initializing variables" *_HSV_INIT_IO $MOVE
0.0000000 ^FRECUENCIA @!
0 ^HZ_SP @!
0 ^HZ_VARIADOR @!
20 ^node_red @!
0 ^ON_OFF_VAR @!
0 ^RESET_ERROR @!
0 ^RPM_VARIADOR @!
