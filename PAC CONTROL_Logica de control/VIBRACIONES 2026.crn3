" i32.HZ_SP" 1 {stPrivateListOfStrategyTags $TABLE@ $MOVE
" f32.FRECUENCIA" 0 {stPrivateListOfStrategyTags $TABLE@ $MOVE
 " " *_HSV_INIT_IO $MOVE
;
T: T_INIT_IO
W_INIT_IO
&Powerup START.T DROP
T;
